## Copy this file to .env and adjust values before running docker-compose up.

# --- PostgreSQL ---
POSTGRES_USER=homeauto
POSTGRES_PASSWORD=changeme-db-password
POSTGRES_DB=homeautomation
# Used by the Next.js app to connect to the postgres service on the compose network.
DATABASE_URL=postgresql://homeauto:changeme-db-password@postgres:5432/homeautomation

# --- MQTT ---
MQTT_URL=mqtt://mosquitto:1883

# --- next-auth ---
# Set to the URL you access the app on (e.g. http://<raspberry-pi-ip>:3000)
NEXTAUTH_URL=http://localhost:3000
# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme-generate-a-real-secret

# --- Seeded admin account (created automatically on first boot) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin-password

# --- Zigbee adapter ---
# Path to your Zigbee USB adapter on the Raspberry Pi host, e.g. /dev/ttyACM0 or /dev/ttyUSB0
ZIGBEE_ADAPTER=/dev/ttyACM0
