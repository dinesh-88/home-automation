generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum DeviceType {
  LIGHT
  HEATER
  SENSOR
  OTHER
}

enum RuleOperator {
  LT
  LTE
  GT
  GTE
  EQ
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(GUEST)
  createdAt    DateTime @default(now())
}

model Device {
  id            String          @id @default(cuid())
  friendlyName  String          @unique
  type          DeviceType      @default(OTHER)
  state         Json            @default("{}")
  available     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  history       DeviceHistory[]
  rulesAsSource Rule[]          @relation("SourceDevice")
  rulesAsTarget Rule[]          @relation("TargetDevice")
}

model DeviceHistory {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  state     Json
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model Rule {
  id             String       @id @default(cuid())
  name           String
  enabled        Boolean      @default(true)
  sourceDeviceId String
  sourceDevice   Device       @relation("SourceDevice", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  metric         String
  operator       RuleOperator
  threshold      Float
  targetDeviceId String
  targetDevice   Device       @relation("TargetDevice", fields: [targetDeviceId], references: [id], onDelete: Cascade)
  action         Json
  elseAction     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([sourceDeviceId])
}
